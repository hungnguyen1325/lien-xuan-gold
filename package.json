{
  "name": "lien-xuan-gold",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "Chrome >= 80",
    "Edge >= 80",
    "Firefox >= 78",
    "Safari >= 13.1",
    "ios_saf >= 13.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src README.md next.config.ts tailwind.config.ts postcss.config.mjs eslint.config.mjs tsconfig.json package.json",
    "format:check": "prettier --check src README.md next.config.ts tailwind.config.ts postcss.config.mjs eslint.config.mjs tsconfig.json package.json"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.10.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
